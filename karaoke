<!DOCTYPE html>
<html lang="id" class="dark h-full bg-slate-950 text-slate-100 font-sans">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NeonVibe Dual Karaoke System</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        neon: {
                            purple: '#a855f7',
                            pink: '#ec4899',
                            cyan: '#06b6d4',
                            emerald: '#10b981'
                        }
                    },
                    boxShadow: {
                        'neon-pink': '0 0 25px -3px rgba(236, 72, 153, 0.5)',
                        'neon-purple': '0 0 25px -3px rgba(168, 85, 247, 0.5)',
                        'neon-cyan': '0 0 25px -3px rgba(6, 182, 212, 0.5)',
                    }
                }
            }
        }
    </script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: rgba(15, 23, 42, 0.8); }
        ::-webkit-scrollbar-thumb { background: rgba(168, 85, 247, 0.4); border-radius: 9999px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(236, 72, 153, 0.7); }

        .glass-panel {
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        
        .glass-card {
            background: rgba(30, 41, 59, 0.6);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        /* Ambient Glow & Equalizer */
        @keyframes pulse-glow {
            0%, 100% { opacity: 0.4; transform: scale(1); }
            50% { opacity: 0.8; transform: scale(1.03); }
        }
        .animate-glow { animation: pulse-glow 4s ease-in-out infinite; }

        @keyframes bar-bounce {
            0%, 100% { height: 15%; }
            50% { height: 95%; }
        }
        .eq-bar-1 { animation: bar-bounce 1.1s ease-in-out infinite; }
        .eq-bar-2 { animation: bar-bounce 0.8s ease-in-out infinite 0.2s; }
        .eq-bar-3 { animation: bar-bounce 1.4s ease-in-out infinite 0.4s; }
        .eq-bar-4 { animation: bar-bounce 0.9s ease-in-out infinite 0.1s; }
    </style>
</head>
<body class="h-full bg-slate-950 text-slate-100 flex flex-col overflow-x-hidden selection:bg-pink-500 selection:text-white">

    <!-- TOP HEADER NAVBAR (Always Visible for mode switching) -->
    <header class="sticky top-0 z-50 w-full glass-panel border-b border-slate-800/80 px-4 sm:px-6 py-3 flex items-center justify-between">
        <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-pink-500 via-purple-600 to-cyan-500 p-0.5 shadow-neon-pink flex items-center justify-center">
                <div class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center">
                    <i class="fa-solid fa-microphone-lines text-pink-400 text-lg"></i>
                </div>
            </div>
            <div>
                <h1 class="text-xl font-extrabold tracking-tight bg-gradient-to-r from-pink-400 via-purple-300 to-cyan-400 bg-clip-text text-transparent">
                    NEON<span class="text-white">KARAOKE</span>
                </h1>
                <p class="text-[10px] sm:text-xs text-slate-400 font-medium">Dual-Screen Realtime Sync System</p>
            </div>
        </div>

        <!-- Mode Navigation & Separate Window Trigger -->
        <div class="flex items-center space-x-2 sm:space-x-3">
            <!-- View Mode Switcher -->
            <div class="bg-slate-900/90 p-1 rounded-xl border border-slate-800 flex items-center text-xs">
                <button id="viewRemoteBtn" onclick="switchViewMode('remote')" class="px-3 py-1.5 rounded-lg font-bold transition flex items-center gap-1.5 bg-purple-600 text-white shadow-neon-purple">
                    <i class="fa-solid fa-sliders text-xs"></i>
                    <span class="hidden sm:inline">1. Remote / Katalog</span>
                </button>
                <button id="viewPlayerBtn" onclick="switchViewMode('player')" class="px-3 py-1.5 rounded-lg font-semibold text-slate-400 hover:text-white transition flex items-center gap-1.5">
                    <i class="fa-solid fa-tv text-xs"></i>
                    <span class="hidden sm:inline">2. Display Player</span>
                </button>
            </div>

            <!-- Open Player in New Tab/Window Button -->
            <button onclick="openPlayerWindow()" title="Buka Pemutar di Window Terpisah untuk TV/Monitor Dual-Screen" class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-cyan-400 border border-slate-700 text-xs font-semibold transition flex items-center gap-2">
                <i class="fa-solid fa-up-right-from-square"></i>
                <span class="hidden md:inline">Buka Display di Window Baru</span>
            </button>
        </div>
    </header>

    <!-- ========================================================================== -->
    <!-- VIEW PAGE 1: REMOTE & SONG CATALOG (PAGE CONTROL & QUEUE)                  -->
    <!-- ========================================================================== -->
    <main id="remotePage" class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        <!-- LEFT COLUMN: Search & Live API Results (7 Cols) -->
        <section class="lg:col-span-7 space-y-6">
            
            <!-- YouTube API Live Search Box -->
            <div class="p-4 sm:p-6 rounded-2xl glass-panel border border-slate-800 space-y-4">
                <div class="flex items-center justify-between">
                    <label class="text-xs font-bold text-slate-400 uppercase tracking-wider flex items-center gap-2">
                        <i class="fa-brands fa-youtube text-rose-500 text-base"></i>
                        <span>Cari Video Karaoke YouTube (Live API)</span>
                    </label>
                    <span class="text-[10px] px-2 py-0.5 rounded bg-purple-950 text-purple-300 border border-purple-800">YouTube Data API v3 Active</span>
                </div>

                <div class="flex flex-col sm:flex-row gap-2">
                    <div class="relative flex-1">
                        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3.5 text-slate-500 text-sm"></i>
                        <input type="text" id="searchInput" placeholder="Ketik judul lagu / penyanyi (contoh: Dewa 19 Karaoke)..." 
                            onkeydown="if(event.key === 'Enter') searchYouTubeKaraoke()"
                            class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700/80 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition">
                    </div>
                    <button onclick="searchYouTubeKaraoke()" id="searchBtn" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-pink-500 to-purple-600 hover:opacity-90 text-white font-bold text-sm transition shadow-neon-pink flex items-center justify-center gap-2 active:scale-95">
                        <i class="fa-solid fa-magnifying-glass text-xs"></i>
                        <span>Cari Lagu</span>
                    </button>
                </div>

                <!-- Quick Presets Badges -->
                <div class="flex items-center gap-2 overflow-x-auto pb-1 text-xs">
                    <span class="text-slate-500 font-semibold text-[11px] whitespace-nowrap">Quick Tag:</span>
                    <button onclick="quickSearch('Pop Indonesia Karaoke')" class="px-3 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700/60 transition whitespace-nowrap"> Pop Indo</button>
                    <button onclick="quickSearch('Dangdut Koplo Karaoke')" class="px-3 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700/60 transition whitespace-nowrap"> Dangdut Koplo</button>
                    <button onclick="quickSearch('Dewa 19 Karaoke')" class="px-3 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700/60 transition whitespace-nowrap"> Dewa 19</button>
                    <button onclick="quickSearch('Rock 90an Karaoke')" class="px-3 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700/60 transition whitespace-nowrap"> Rock 90s</button>
                    <button onclick="quickSearch('Nostalgia Karaoke')" class="px-3 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700/60 transition whitespace-nowrap"> Nostalgia</button>
                </div>
            </div>

            <!-- Search Results Container -->
            <div class="space-y-3">
                <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider flex items-center justify-between">
                    <span>Hasil Pencarian</span>
                    <span id="resultsCount" class="text-[11px] text-slate-500">0 Video ditemukan</span>
                </h3>

                <div id="searchResultsList" class="space-y-3 min-h-[300px] max-h-[550px] overflow-y-auto pr-1">
                    <!-- Default State Before Searching -->
                    <div class="py-16 text-center text-slate-500 glass-card rounded-2xl border border-dashed border-slate-800 p-6">
                        <i class="fa-solid fa-compact-disc text-4xl mb-3 text-purple-500/40 animate-spin" style="animation-duration: 10s;"></i>
                        <p class="text-sm font-semibold text-slate-400">Siap Mencari Lagu Karaoke</p>
                        <p class="text-xs text-slate-600 mt-1">Ketik nama penyanyi/judul lagu di atas untuk memanggil data langsung dari YouTube Data API.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- RIGHT COLUMN: Remote Control & Queue (5 Cols) -->
        <section class="lg:col-span-5 space-y-6">

            <!-- Realtime Remote Player Controller Dashboard -->
            <div class="p-5 rounded-2xl glass-panel border border-slate-800 space-y-4 shadow-xl">
                <div class="flex items-center justify-between border-b border-slate-800/80 pb-3">
                    <span class="text-xs font-bold text-slate-400 uppercase tracking-wider flex items-center gap-2">
                        <i class="fa-solid fa-gamepad text-cyan-400"></i>
                        <span>Remote Control Display</span>
                    </span>
                    <span id="playerStatusBadge" class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-slate-900 text-slate-400 border border-slate-800">
                        OFFLINE
                    </span>
                </div>

                <!-- Now Playing Mini Title -->
                <div class="bg-slate-900/80 p-3 rounded-xl border border-slate-800">
                    <div class="text-[10px] text-purple-400 font-bold uppercase tracking-wider mb-1 flex items-center gap-1.5">
                        <i class="fa-solid fa-music"></i>
                        <span>Sedang Diputar Di Display</span>
                    </div>
                    <div id="remoteNowPlayingTitle" class="text-sm font-bold text-white truncate">
                        - Tidak Ada Lagu -
                    </div>
                </div>

                <!-- Controller Buttons -->
                <div class="grid grid-cols-4 gap-2 pt-1">
                    <button onclick="sendRemoteCommand('replay')" title="Mulai Ulang Lagu" class="py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700/60 font-semibold text-xs transition flex flex-col items-center justify-center gap-1 active:scale-95">
                        <i class="fa-solid fa-rotate-left text-sm text-cyan-400"></i>
                        <span>Replay</span>
                    </button>
                    <button onclick="sendRemoteCommand('togglePlay')" id="remotePlayBtn" title="Play/Pause" class="py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs transition shadow-neon-purple flex flex-col items-center justify-center gap-1 active:scale-95">
                        <i class="fa-solid fa-play text-sm"></i>
                        <span>Play/Pause</span>
                    </button>
                    <button onclick="sendRemoteCommand('next')" title="Lagu Berikutnya" class="py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700/60 font-semibold text-xs transition flex flex-col items-center justify-center gap-1 active:scale-95">
                        <i class="fa-solid fa-forward-step text-sm text-pink-400"></i>
                        <span>Skip</span>
                    </button>
                    <button onclick="sendRemoteCommand('mute')" id="remoteMuteBtn" title="Mute/Unmute" class="py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700/60 font-semibold text-xs transition flex flex-col items-center justify-center gap-1 active:scale-95">
                        <i class="fa-solid fa-volume-high text-sm text-amber-400"></i>
                        <span>Mute</span>
                    </button>
                </div>

                <!-- Volume Slider -->
                <div class="flex items-center space-x-3 bg-slate-900/60 p-2.5 rounded-xl border border-slate-800/80">
                    <i class="fa-solid fa-volume-low text-xs text-slate-500"></i>
                    <input type="range" id="remoteVolume" min="0" max="100" value="100" oninput="sendRemoteCommand('volume', this.value)" class="w-full h-1.5 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-purple-500">
                    <i class="fa-solid fa-volume-high text-xs text-slate-500"></i>
                </div>
            </div>

            <!-- Queue List Management Section -->
            <div class="p-5 rounded-2xl glass-panel border border-slate-800 space-y-4">
                <div class="flex items-center justify-between">
                    <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider flex items-center gap-2">
                        <i class="fa-solid fa-list-ol text-pink-400"></i>
                        <span>Antrean Lagu (<span id="queueBadge">0</span>)</span>
                    </h3>
                    <button onclick="clearQueue()" class="text-xs text-slate-500 hover:text-rose-400 transition flex items-center gap-1">
                        <i class="fa-solid fa-trash-can text-[11px]"></i>
                        <span>Kosongkan</span>
                    </button>
                </div>

                <!-- List Item Queue -->
                <div id="remoteQueueList" class="space-y-2 min-h-[200px] max-h-[380px] overflow-y-auto pr-1">
                    <!-- Injected dynamically -->
                </div>
            </div>
        </section>
    </main>


    <!-- ========================================================================== -->
    <!-- VIEW PAGE 2: STANDALONE DISPLAY PLAYER (FOR TV / MAIN MONITOR DISPLAY)    -->
    <!-- ========================================================================== -->
    <main id="playerPage" class="flex-1 w-full max-w-7xl mx-auto p-4 sm:p-6 flex flex-col items-center justify-center hidden">
        
        <div class="relative w-full max-w-5xl rounded-3xl overflow-hidden glass-panel border-2 border-purple-500/40 shadow-neon-purple group">
            
            <!-- Video Aspect 16:9 Frame -->
            <div class="relative w-full aspect-video bg-black flex items-center justify-center">
                
                <!-- YouTube API Player Anchor -->
                <div id="player" class="w-full h-full"></div>

                <!-- Empty State Screen -->
                <div id="playerPlaceholder" class="absolute inset-0 bg-gradient-to-tr from-slate-950 via-slate-900 to-purple-950 flex flex-col items-center justify-center p-8 text-center z-10">
                    <div class="relative mb-6">
                        <div class="w-24 h-24 rounded-full bg-purple-600/20 border-2 border-purple-500/50 flex items-center justify-center text-pink-400 text-4xl shadow-neon-pink animate-glow">
                            <i class="fa-solid fa-tv"></i>
                        </div>
                    </div>
                    <h2 class="text-2xl sm:text-3xl font-black text-white mb-2 tracking-tight">KARAOKE LOUNGE DISPLAY</h2>
                    <p class="text-sm text-slate-400 max-w-md">Layar pemutar aktif. Pilih lagu dari Halaman Remote Control / Katalog untuk mulai bernyanyi.</p>
                </div>

                <!-- NOW PLAYING OVERLAY BADGE -->
                <div class="absolute top-4 left-4 z-20 flex items-center gap-2">
                    <span id="playerStatusBadgeDisplay" class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-bold bg-slate-900/90 text-slate-200 border border-slate-700/80 backdrop-blur-md shadow-lg">
                        <span class="w-2.5 h-2.5 rounded-full bg-slate-500" id="playerStatusDot"></span>
                        <span id="playerStatusText">STANDBY</span>
                    </span>
                </div>

                <!-- Neon Audio Visualizer (Bottom Right) -->
                <div id="displayEqualizer" class="absolute bottom-5 right-5 z-20 flex items-end space-x-1.5 h-8 px-3 py-2 rounded-xl bg-slate-950/80 backdrop-blur-md border border-slate-800 hidden">
                    <div class="w-1.5 bg-pink-500 rounded-full eq-bar-1"></div>
                    <div class="w-1.5 bg-purple-500 rounded-full eq-bar-2"></div>
                    <div class="w-1.5 bg-cyan-500 rounded-full eq-bar-3"></div>
                    <div class="w-1.5 bg-emerald-400 rounded-full eq-bar-4"></div>
                </div>
            </div>

            <!-- Current Song Info Bar Below Player -->
            <div class="p-4 sm:p-5 bg-slate-950/90 border-t border-slate-800 flex items-center justify-between">
                <div class="min-w-0 pr-4">
                    <div class="flex items-center gap-2 text-xs font-bold text-pink-400 uppercase tracking-widest mb-1">
                        <i class="fa-solid fa-compact-disc animate-spin" style="animation-duration: 6s;"></i>
                        <span>NOW PLAYING</span>
                    </div>
                    <h2 id="displayNowPlayingTitle" class="text-lg sm:text-xl font-extrabold text-white truncate">
                        - Tidak Ada Lagu Diputar -
                    </h2>
                </div>

                <!-- Next Up Toast Mini Banner -->
                <div id="nextUpBanner" class="hidden sm:flex items-center gap-3 bg-purple-950/40 border border-purple-800/40 px-3.5 py-2 rounded-xl text-xs text-purple-300 max-w-xs">
                    <i class="fa-solid fa-forward-step text-purple-400"></i>
                    <div class="truncate">
                        <div class="text-[10px] text-purple-400 font-bold uppercase">BERIKUTNYA</div>
                        <div id="nextUpTitle" class="truncate font-semibold text-white">...</div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- TOAST NOTIFICATION SYSTEM -->
    <div id="toastContainer" class="fixed bottom-5 right-5 z-50 flex flex-col space-y-2 pointer-events-none"></div>

    <!-- JAVASCRIPT APPLICATION LOGIC -->
    <script>
        /* ==========================================================================
           1. CONFIG & REALTIME BROADCAST CHANNEL SYNC
           ========================================================================== */
        const YOUTUBE_API_KEY = "AIzaSyCrogZjjtH00X5MsDYs79ZCnB9ljI2bdRk";
        
        // BroadcastChannel API for multi-tab/window Instant Sync
        const karaokeChannel = new BroadcastChannel('karaoke_channel');

        // Application State
        let songQueue = JSON.parse(localStorage.getItem('karaoke_queue')) || [];
        let currentTrack = JSON.parse(localStorage.getItem('karaoke_current')) || null;
        let isPlaying = false;
        let player = null;
        let viewMode = 'remote'; // 'remote' or 'player'

        // Detect View Mode from URL query parameter if opened in new tab/window
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('mode') === 'player') {
            viewMode = 'player';
        }

        /* ==========================================================================
           2. BROADCAST CHANNEL EVENT LISTENERS (SYNC MANAGEMENT)
           ========================================================================== */
        karaokeChannel.onmessage = (event) => {
            const { type, payload } = event.data;
            console.log("Broadcast Event Received:", type, payload);

            switch (type) {
                case 'QUEUE_UPDATED':
                    songQueue = payload;
                    localStorage.setItem('karaoke_queue', JSON.stringify(songQueue));
                    updateQueueUI();
                    updateNextUpBanner();
                    break;
                
                case 'PLAY_TRACK':
                    currentTrack = payload;
                    localStorage.setItem('karaoke_current', JSON.stringify(currentTrack));
                    updateNowPlayingUI();
                    if (viewMode === 'player' && player && player.loadVideoById) {
                        player.loadVideoById(currentTrack.id);
                    }
                    break;

                case 'REMOTE_COMMAND':
                    handleRemoteCommand(payload.cmd, payload.val);
                    break;

                case 'PLAYER_STATE_CHANGE':
                    handlePlayerStateFromDisplay(payload.state, payload.track);
                    break;
            }
        };

        // Fallback LocalStorage Sync Event
        window.addEventListener('storage', (e) => {
            if (e.key === 'karaoke_queue') {
                songQueue = JSON.parse(e.newValue) || [];
                updateQueueUI();
                updateNextUpBanner();
            } else if (e.key === 'karaoke_current') {
                currentTrack = JSON.parse(e.newValue);
                updateNowPlayingUI();
            }
        });

        /* ==========================================================================
           3. YOUTUBE DATA API V3 LIVE SEARCH
           ========================================================================== */
        async function searchYouTubeKaraoke() {
            const input = document.getElementById('searchInput');
            const searchBtn = document.getElementById('searchBtn');
            const query = input.value.trim();

            if (!query) {
                showToast("Masukkan kata kunci pencarian!", "warning");
                return;
            }

            searchBtn.disabled = true;
            searchBtn.innerHTML = `<i class="fa-solid fa-spinner animate-spin"></i><span>Mencari...</span>`;

            // Append "karaoke" keyword if user hasn't typed it
            const searchQuery = query.toLowerCase().includes('karaoke') ? query : `${query} karaoke`;
            const apiEndpoint = `https://www.googleapis.com/youtube/v3/search?part=snippet&maxResults=15&q=${encodeURIComponent(searchQuery)}&type=video&key=${YOUTUBE_API_KEY}`;

            try {
                const response = await fetch(apiEndpoint);
                const data = await response.json();

                if (data.error) {
                    throw new Error(data.error.message);
                }

                renderSearchResults(data.items || []);
            } catch (err) {
                console.error("YouTube API Error:", err);
                showToast("Gagal memanggil API YouTube: " + err.message, "error");
            } finally {
                searchBtn.disabled = false;
                searchBtn.innerHTML = `<i class="fa-solid fa-magnifying-glass text-xs"></i><span>Cari Lagu</span>`;
            }
        }

        function quickSearch(tagQuery) {
            document.getElementById('searchInput').value = tagQuery;
            searchYouTubeKaraoke();
        }

        function renderSearchResults(items) {
            const container = document.getElementById('searchResultsList');
            const resultsCount = document.getElementById('resultsCount');

            resultsCount.innerText = `${items.length} Video ditemukan`;

            if (items.length === 0) {
                container.innerHTML = `
                    <div class="py-12 text-center text-slate-500 glass-card rounded-xl border border-slate-800">
                        <p class="text-sm font-semibold">Lagu tidak ditemukan</p>
                        <p class="text-xs">Coba kata kunci penyanyi atau lagu lain.</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = items.map(item => {
                const videoId = item.id.videoId;
                const title = item.snippet.title;
                const channel = item.snippet.channelTitle;
                const thumb = item.snippet.thumbnails.medium.url;

                const trackObj = JSON.stringify({ id: videoId, title: title, artist: channel }).replace(/'/g, "&apos;");

                return `
                    <div class="flex items-center justify-between p-3 rounded-xl glass-card hover:border-purple-500/50 transition group">
                        <div class="flex items-center space-x-3 min-w-0 flex-1">
                            <img src="${thumb}" alt="thumb" class="w-20 h-12 object-cover rounded-lg border border-slate-800 flex-shrink-0">
                            <div class="min-w-0 flex-1">
                                <h4 class="text-xs sm:text-sm font-bold text-slate-200 truncate group-hover:text-pink-400 transition">${title}</h4>
                                <p class="text-[11px] text-slate-400">${channel}</p>
                            </div>
                        </div>
                        <div class="flex items-center space-x-1.5 pl-3">
                            <button onclick='addToQueueDirect(${trackObj})' class="px-3 py-1.5 rounded-lg bg-purple-600 hover:bg-purple-500 text-white font-semibold text-xs transition shadow-neon-purple flex items-center gap-1 active:scale-95">
                                <i class="fa-solid fa-plus text-[10px]"></i>
                                <span class="hidden sm:inline">Antrean</span>
                            </button>
                            <button onclick='playNowDirect(${trackObj})' class="px-3 py-1.5 rounded-lg bg-pink-600 hover:bg-pink-500 text-white font-semibold text-xs transition shadow-neon-pink flex items-center gap-1 active:scale-95">
                                <i class="fa-solid fa-play text-[10px]"></i>
                                <span class="hidden sm:inline">Putar</span>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
        }

        /* ==========================================================================
           4. YOUTUBE IFRAME PLAYER ENGINE (FOR DISPLAY PAGE)
           ========================================================================== */
        // Load YouTube API Script
        const tag = document.createElement('script');
        tag.src = "https://www.youtube.com/iframe_api";
        document.head.appendChild(tag);

        function onYouTubeIframeAPIReady() {
            player = new YT.Player('player', {
                height: '100%',
                width: '100%',
                videoId: currentTrack ? currentTrack.id : '',
                playerVars: {
                    'autoplay': 1,
                    'controls': 1,
                    'modestbranding': 1,
                    'rel': 0
                },
                events: {
                    'onReady': onPlayerReady,
                    'onStateChange': onPlayerStateChange,
                    'onError': onPlayerError
                }
            });
        }

        function onPlayerReady(event) {
            console.log("Player Display Ready");
            if (currentTrack) {
                player.loadVideoById(currentTrack.id);
            }
        }

        function onPlayerStateChange(event) {
            let stateStr = "STANDBY";
            if (event.data === YT.PlayerState.PLAYING) {
                stateStr = "PLAYING";
                document.getElementById('playerPlaceholder').classList.add('opacity-0', 'pointer-events-none');
                document.getElementById('displayEqualizer').classList.remove('hidden');
            } else if (event.data === YT.PlayerState.PAUSED) {
                stateStr = "PAUSED";
                document.getElementById('displayEqualizer').classList.add('hidden');
            } else if (event.data === YT.PlayerState.ENDED) {
                stateStr = "ENDED";
                document.getElementById('displayEqualizer').classList.add('hidden');
                // Auto play next from queue
                playNextSongInQueue();
            }

            // Sync state to Remote Window
            karaokeChannel.postMessage({
                type: 'PLAYER_STATE_CHANGE',
                payload: { state: stateStr, track: currentTrack }
            });

            updateDisplayStatusUI(stateStr);
        }

        function onPlayerError(event) {
            showToast("Video terblokir atau bermasalah. Melompati...", "error");
            setTimeout(() => {
                playNextSongInQueue();
            }, 1500);
        }

        function updateDisplayStatusUI(stateStr) {
            const statusDot = document.getElementById('playerStatusDot');
            const statusText = document.getElementById('playerStatusText');
            
            if (stateStr === 'PLAYING') {
                statusDot.className = "w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping";
                statusText.innerText = "PLAYING";
                statusText.className = "text-emerald-400 font-bold";
            } else if (stateStr === 'PAUSED') {
                statusDot.className = "w-2.5 h-2.5 rounded-full bg-amber-400";
                statusText.innerText = "PAUSED";
                statusText.className = "text-amber-400 font-bold";
            } else {
                statusDot.className = "w-2.5 h-2.5 rounded-full bg-slate-500";
                statusText.innerText = "STANDBY";
                statusText.className = "text-slate-400 font-bold";
            }
        }

        /* ==========================================================================
           5. QUEUE & REMOTE COMMAND HANDLERS
           ========================================================================== */
        function addToQueueDirect(track) {
            songQueue.push(track);
            syncQueue();
            showToast(`"${track.title.substring(0, 25)}..." ditambahkan ke antrean`, "success");

            // Auto Play if standby
            if (!currentTrack) {
                playNextSongInQueue();
            }
        }

        function playNowDirect(track) {
            currentTrack = track;
            localStorage.setItem('karaoke_current', JSON.stringify(currentTrack));
            
            karaokeChannel.postMessage({
                type: 'PLAY_TRACK',
                payload: currentTrack
            });

            updateNowPlayingUI();
            if (viewMode === 'player' && player && player.loadVideoById) {
                player.loadVideoById(currentTrack.id);
            }
        }

        function playNextSongInQueue() {
            if (songQueue.length > 0) {
                const nextTrack = songQueue.shift();
                syncQueue();
                playNowDirect(nextTrack);
            } else {
                currentTrack = null;
                localStorage.removeItem('karaoke_current');
                karaokeChannel.postMessage({
                    type: 'PLAY_TRACK',
                    payload: null
                });
                updateNowPlayingUI();
                if (player && player.stopVideo) player.stopVideo();
            }
        }

        function syncQueue() {
            localStorage.setItem('karaoke_queue', JSON.stringify(songQueue));
            karaokeChannel.postMessage({
                type: 'QUEUE_UPDATED',
                payload: songQueue
            });
            updateQueueUI();
            updateNextUpBanner();
        }

        function sendRemoteCommand(cmd, val = null) {
            karaokeChannel.postMessage({
                type: 'REMOTE_COMMAND',
                payload: { cmd, val }
            });
            // Execute locally if in player view as well
            handleRemoteCommand(cmd, val);
        }

        function handleRemoteCommand(cmd, val) {
            if (!player) return;

            switch (cmd) {
                case 'togglePlay':
                    if (player.getPlayerState() === YT.PlayerState.PLAYING) {
                        player.pauseVideo();
                    } else {
                        player.playVideo();
                    }
                    break;
                case 'next':
                    playNextSongInQueue();
                    break;
                case 'replay':
                    player.seekTo(0);
                    player.playVideo();
                    break;
                case 'mute':
                    if (player.isMuted()) player.unMute(); else player.mute();
                    break;
                case 'volume':
                    player.setVolume(val);
                    break;
            }
        }

        function handlePlayerStateFromDisplay(state, track) {
            const badge = document.getElementById('playerStatusBadge');
            const playBtn = document.getElementById('remotePlayBtn');

            if (state === 'PLAYING') {
                badge.innerText = "ONLINE: PLAYING";
                badge.className = "px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-950 text-emerald-300 border border-emerald-800";
                playBtn.innerHTML = `<i class="fa-solid fa-pause text-sm"></i><span>Pause</span>`;
            } else if (state === 'PAUSED') {
                badge.innerText = "ONLINE: PAUSED";
                badge.className = "px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-950 text-amber-300 border border-amber-800";
                playBtn.innerHTML = `<i class="fa-solid fa-play text-sm"></i><span>Play</span>`;
            } else {
                badge.innerText = "STANDBY";
                badge.className = "px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-slate-900 text-slate-400 border border-slate-800";
            }
        }

        function removeFromQueue(index) {
            songQueue.splice(index, 1);
            syncQueue();
        }

        function moveQueueItem(index, direction) {
            const target = index + direction;
            if (target >= 0 && target < songQueue.length) {
                const temp = songQueue[index];
                songQueue[index] = songQueue[target];
                songQueue[target] = temp;
                syncQueue();
            }
        }

        function clearQueue() {
            songQueue = [];
            syncQueue();
        }

        /* ==========================================================================
           6. UI RENDERERS & VIEW SWITCHING
           ========================================================================== */
        function switchViewMode(mode) {
            viewMode = mode;
            const remotePage = document.getElementById('remotePage');
            const playerPage = document.getElementById('playerPage');
            const viewRemoteBtn = document.getElementById('viewRemoteBtn');
            const viewPlayerBtn = document.getElementById('viewPlayerBtn');

            if (mode === 'remote') {
                remotePage.classList.remove('hidden');
                playerPage.classList.add('hidden');
                viewRemoteBtn.className = "px-3 py-1.5 rounded-lg font-bold transition flex items-center gap-1.5 bg-purple-600 text-white shadow-neon-purple";
                viewPlayerBtn.className = "px-3 py-1.5 rounded-lg font-semibold text-slate-400 hover:text-white transition flex items-center gap-1.5";
            } else {
                remotePage.classList.add('hidden');
                playerPage.classList.remove('hidden');
                viewPlayerBtn.className = "px-3 py-1.5 rounded-lg font-bold transition flex items-center gap-1.5 bg-purple-600 text-white shadow-neon-purple";
                viewRemoteBtn.className = "px-3 py-1.5 rounded-lg font-semibold text-slate-400 hover:text-white transition flex items-center gap-1.5";
            }
        }

        function openPlayerWindow() {
            const currentUrl = window.location.href.split('?')[0];
            window.open(`${currentUrl}?mode=player`, 'KaraokePlayerWindow', 'width=1280,height=720');
        }

        function updateNowPlayingUI() {
            const remoteTitle = document.getElementById('remoteNowPlayingTitle');
            const displayTitle = document.getElementById('displayNowPlayingTitle');
            const titleText = currentTrack ? currentTrack.title : "- Tidak Ada Lagu Diputar -";

            remoteTitle.innerText = titleText;
            displayTitle.innerText = titleText;
        }

        function updateQueueUI() {
            const list = document.getElementById('remoteQueueList');
            const badge = document.getElementById('queueBadge');
            badge.innerText = songQueue.length;

            if (songQueue.length === 0) {
                list.innerHTML = `
                    <div class="py-8 text-center text-slate-500 glass-card rounded-xl border border-slate-800">
                        <p class="text-xs">Antrean lagu kosong</p>
                    </div>
                `;
                return;
            }

            list.innerHTML = songQueue.map((track, idx) => `
                <div class="flex items-center justify-between p-2.5 rounded-xl glass-card border border-slate-800/80">
                    <div class="flex items-center space-x-2.5 min-w-0 flex-1">
                        <span class="w-5 h-5 rounded bg-slate-900 text-slate-400 text-[11px] font-bold flex items-center justify-center">${idx + 1}</span>
                        <div class="min-w-0 flex-1">
                            <h4 class="text-xs font-bold text-slate-200 truncate">${track.title}</h4>
                            <p class="text-[10px] text-slate-400">${track.artist || 'Karaoke'}</p>
                        </div>
                    </div>
                    <div class="flex items-center space-x-1 pl-2">
                        <button onclick="moveQueueItem(${idx}, -1)" ${idx === 0 ? 'disabled class="opacity-20 text-slate-600"' : 'class="p-1 text-slate-400 hover:text-white"'}>
                            <i class="fa-solid fa-chevron-up text-xs"></i>
                        </button>
                        <button onclick="moveQueueItem(${idx}, 1)" ${idx === songQueue.length - 1 ? 'disabled class="opacity-20 text-slate-600"' : 'class="p-1 text-slate-400 hover:text-white"'}>
                            <i class="fa-solid fa-chevron-down text-xs"></i>
                        </button>
                        <button onclick="removeFromQueue(${idx})" class="p-1 text-slate-400 hover:text-rose-400">
                            <i class="fa-solid fa-xmark text-sm"></i>
                        </button>
                    </div>
                </div>
            `).join('');
        }

        function updateNextUpBanner() {
            const banner = document.getElementById('nextUpBanner');
            const nextTitle = document.getElementById('nextUpTitle');

            if (songQueue.length > 0) {
                banner.classList.remove('hidden');
                nextTitle.innerText = songQueue[0].title;
            } else {
                banner.classList.add('hidden');
            }
        }

        function showToast(msg, type = 'info') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            
            const colors = {
                success: 'bg-emerald-950/90 border-emerald-500/50 text-emerald-200',
                error: 'bg-rose-950/90 border-rose-500/50 text-rose-200',
                warning: 'bg-amber-950/90 border-amber-500/50 text-amber-200',
                info: 'bg-slate-900/90 border-purple-500/50 text-purple-200'
            };

            toast.className = `px-4 py-3 rounded-xl border backdrop-blur-md text-xs font-semibold shadow-2xl transition-all duration-300 translate-y-4 opacity-0 pointer-events-auto ${colors[type] || colors.info}`;
            toast.innerHTML = `<span>${msg}</span>`;

            container.appendChild(toast);
            setTimeout(() => toast.classList.remove('translate-y-4', 'opacity-0'), 50);
            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Initialize UI on Load
        window.onload = () => {
            switchViewMode(viewMode);
            updateQueueUI();
            updateNowPlayingUI();
            updateNextUpBanner();
        };
    </script>
</body>
</html>